# Copy to .env.local for local development. Placeholders only — never commit real values.
# Everything prefixed VITE_ ends up in the public browser bundle. Only public keys belong here.

# demo = fictional data, nothing shared. live = Supabase backend (fails loudly if incomplete).
VITE_DATA_MODE=demo

# Supabase project URL and PUBLISHABLE key (sb_publishable_...). Never the secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Cloudflare Turnstile SITE key (public). The secret key goes in Supabase secrets, not here.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAreplace_me

# Address search + routing. Default "osm" = free, keyless OpenStreetMap services
# (Nominatim search, FOSSGIS OSRM routing). No account or key needed.
# VITE_GEO_PROVIDER=osm
# Optional paid-tier-capable alternative (free daily credits, needs a key): VITE_GEO_PROVIDER=geoapify
# VITE_GEOAPIFY_KEY=

# Optional
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_RECOLOR=true
# VITE_DEFAULT_CENTER=39.5,-98.35
# VITE_DEFAULT_ZOOM=3.6
# BASE_PATH=./
